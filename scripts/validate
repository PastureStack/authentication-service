#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo Running validation

PACKAGES=". $(find -name '*.go' | xargs -I{} dirname {} |  cut -f2 -d/ | sort -u | grep -Ev '(^\.$|.git|vendor|bin)' | sed -e 's!^!./!' -e 's!$!/...!')"
EXPECTED_GO_VERSION=go1.26.5

test "$(go env GOVERSION)" = "$EXPECTED_GO_VERSION"
test -x bin/authentication-service
test "$(go version bin/authentication-service | awk '{print $2}')" = \
    "$EXPECTED_GO_VERSION"
printf 'Validated Go toolchain and binary version: %s\n' "$EXPECTED_GO_VERSION"

echo Running: go vet
go vet ${PACKAGES}
printf "%s\n" "Running supported validation: go vet and go fmt."
echo Running: go fmt
test -z "$(go fmt ${PACKAGES} | tee /dev/stderr)"
