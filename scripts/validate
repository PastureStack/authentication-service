#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo Running validation

PACKAGES="./..."
EXPECTED_GO_VERSION=go1.26.5

test -f go.mod
test -f go.sum
test -f vendor/modules.txt
test -f ubuntu-apt.lock
test -f vendor/github.com/crewjam/saml/LICENSE
test ! -e vendor/github.com/crewjam/saml/xmlenc/fuzz.go
test "$(tail -n 1 Dockerfile.dapper)" = 'CMD ["ci"]'
grep -Fx 'USER 65532:65532' Dockerfile.dapper >/dev/null
grep -Fx 'FROM ubuntu:26.04@sha256:678c6550cc43645e08669028bc177f50be4e7c5b8cca677067b1914d4afc7a03' Dockerfile.dapper >/dev/null
grep -F 'https://snapshot.ubuntu.com/ubuntu/%s' Dockerfile.dapper >/dev/null
if grep -R -E -l \
    --exclude-dir=.git \
    --exclude-dir=bin \
    --exclude-dir=dist \
    -- 'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY' .; then
    printf '%s\n' 'Rejected private key material in the committed source tree.' >&2
    exit 1
fi
test "$(go env GOVERSION)" = "$EXPECTED_GO_VERSION"

. ./ubuntu-apt.lock
while IFS='|' read -r package expected_version; do
    actual_version=$(dpkg-query -W -f='${Version}' "$package")
    if [ "$actual_version" != "$expected_version" ]; then
        printf 'Unexpected %s version: expected %s, found %s\n' \
            "$package" "$expected_version" "$actual_version" >&2
        exit 1
    fi
done <<EOF
bash|${UBUNTU_APT_BASH_VERSION}
ca-certificates|${UBUNTU_APT_CA_CERTIFICATES_VERSION}
curl|${UBUNTU_APT_CURL_VERSION}
file|${UBUNTU_APT_FILE_VERSION}
gcc|${UBUNTU_APT_GCC_VERSION}
git|${UBUNTU_APT_GIT_VERSION}
libc6-dev|${UBUNTU_APT_LIBC6_DEV_VERSION}
make|${UBUNTU_APT_MAKE_VERSION}
tar|${UBUNTU_APT_TAR_VERSION}
xz-utils|${UBUNTU_APT_XZ_UTILS_VERSION}
EOF
test -s /licenses/AUTHENTICATION-SERVICE-UBUNTU-APT-PACKAGES.tsv
grep -Fx "snapshot	${UBUNTU_APT_SNAPSHOT}" \
    /licenses/AUTHENTICATION-SERVICE-UBUNTU-APT-PACKAGES.tsv >/dev/null

if [ "$(go env GOHOSTOS)" = "$(go env GOOS)" ]; then
    test -x bin/authentication-service
else
    test -f bin/authentication-service
fi
test "$(go version bin/authentication-service | awk '{print $2}')" = \
    "$EXPECTED_GO_VERSION"
printf 'Validated Go toolchain and binary version: %s\n' "$EXPECTED_GO_VERSION"

echo Running: go vet
go list -mod=vendor -deps ${PACKAGES} >/dev/null
go vet -mod=vendor ${PACKAGES}
printf "%s\n" "Running supported validation: go vet and go fmt."
echo Running: gofmt
UNFORMATTED=$(
    find . \
        -path './vendor' -prune -o \
        -path './bin' -prune -o \
        -name '*.go' -print |
        xargs gofmt -l
)
if [ -n "$UNFORMATTED" ]; then
    printf '%s\n' "$UNFORMATTED" >&2
    exit 1
fi
